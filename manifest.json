{
  "manifest_version": 3,
  "name": "Pop Chain",
  "version": "1.0.0",
  "description": "A fast, focused target-chaining mini-game.",
  "action": {
    "default_title": "Pop Chain",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "image/icon-16.png",
      "32": "image/icon-32.png",
      "48": "image/icon-48.png",
      "128": "image/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pop-chains@ashokri.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "image/icon-16.png",
    "32": "image/icon-32.png",
    "48": "image/icon-48.png",
    "128": "image/icon-128.png"
  }
}
